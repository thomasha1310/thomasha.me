---
import Layout from "../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type ContentItem = CollectionEntry<"writeups"> | CollectionEntry<"projects">;

const writeups = await getCollection("writeups");
const sortedWriteups = writeups.sort(
    (a: ContentItem, b: ContentItem) =>
        b.data.date.valueOf() - a.data.date.valueOf(),
);

const projects = await getCollection("projects");
const sortedProjects = projects.sort(
    (a: ContentItem, b: ContentItem) =>
        b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
    title="home"
    description="Incoming APMA-CS at Brown University. Aspiring cybersecurity vulnerability researcher."
>
    <section class="space-y-8">
        <div class="space-y-2">
            <h1>thomas ha</h1>
            <p class="text-sm">
                freshman @ brown university ⧸ applied math + computer science
            </p>
            <div class="flex gap-4 text-sm">
                <a href="mailto:hello@thomasha.me"> email </a>
                <a href="https://github.com/thomasha1310" target="_blank">
                    github
                </a>
                <a
                    href="https://www.linkedin.com/in/thomasha1310/"
                    target="_blank"
                >
                    linkedin
                </a>
                <a href="/resume.pdf" rel="noopener noreferrer" target="_blank">
                    résumé
                </a>
            </div>
        </div>

        <p>
            i'm an aspiring cybersecurity vulnerability researcher and software
            developer. i spend my time learning about vulnerabilities,
            participating in ctfs, and building simple, resilient software
            infrastructure.
        </p>

        <div>
            <h3>CURRENTLY</h3>
            <p>
                <a
                    href="https://github.com/thomasha1310/clox-interpreter"
                    target="_blank">implementing</a
                > the <a
                    href="https://craftinginterpreters.com/the-lox-language.html"
                    target="_blank">lox programming language</a
                > in C using a bytecode interpreter
            </p>
        </div>

        <div>
            <h3>COURSEWORK</h3>
            <p>csci 0190 (accelerated intro to computer science) @ brown</p>
            <p>math 0540 (linear algebra with theory) @ brown</p>
            <p>math 230 (differential equations) @ massasoit</p>
        </div>

        <div>
            <h3>PROJECTS</h3>
            <div class="flex flex-col space-y-6 mt-4">
                <div class="flex flex-col sm:flex-row sm:gap-6">
                    <span
                        class="text-sm text-gray-500 sm:w-16 shrink-0 sm:mt-0.5"
                        >2026</span
                    >
                    <div class="flex flex-col">
                        <a
                            href="/projects/tetragon"
                            class="text-gray-200 font-medium hover:text-white transition-colors"
                        >
                            tetragon
                        </a>
                        <p class="text-sm mt-1">
                            a full-stack tournament logistics platform for
                            real-time operations. used by the <a
                                href="https://sharonmathscitourn.wixsite.com/smst"
                                target="_blank"
                                >sharon math and science tournament</a
                            > for a 200+ person event.
                        </p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row sm:gap-6">
                    <span
                        class="text-sm text-gray-500 sm:w-16 shrink-0 sm:mt-0.5"
                        >2025</span
                    >
                    <div class="flex flex-col">
                        <a
                            href="/projects/phishfence"
                            class="text-gray-200 font-medium hover:text-white transition-colors"
                        >
                            phishfence
                        </a>
                        <p class="text-sm mt-1">
                            a phishing detection pipeline that explains its
                            reasoning. achieved 99.3% accuracy on a custom
                            dataset of 80,000+ emails.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <h3>WRITEUPS</h3>
            <div class="flex flex-col space-y-6 mt-4">
                {
                    sortedWriteups.map((post: ContentItem) => (
                        <div class="flex flex-col sm:flex-row sm:gap-6">
                            <span class="text-sm text-gray-500 sm:w-16 shrink-0 sm:mt-0.5">
                                {post.data.date
                                    .toLocaleDateString("en-US", {
                                        month: "short",
                                        year: "numeric",
                                        timeZone: "UTC",
                                    })
                                    .toLowerCase()}
                            </span>
                            <div class="flex flex-col">
                                <a
                                    href={`/writeups/${post.id}`}
                                    class="text-gray-200 font-medium hover:text-white transition-colors"
                                >
                                    {post.data.title}
                                </a>
                                <p class="text-sm mt-1">
                                    {post.data.description}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>

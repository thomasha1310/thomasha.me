---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" description="Page not found.">
  <section class="space-y-6 mt-12">
    <h1 class="text-5xl font-bold text-gray-100 tracking-tight">404</h1>
    <h2 class="text-lg font-medium text-gray-300">
      page not found.
    </h2>
    <p class="text-gray-400">
      the endpoint you are looking for doesn't exist, has been moved, or you are poking around where you shouldn't be.
    </p>
    <div class="pt-4">
      <a href="/">
        return home
      </a>
    </div>
  </section>
</Layout>
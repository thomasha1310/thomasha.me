---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="tetragon"
    description="a full-stack tournament logistics platform for real-time operations."
>
    <div class="mt-8">
        <a href="/" class="text-sm">return home </a>

        <header class="mb-4 mt-4">
            <p class="text-sm text-gray-500">2026</p>
            <h1 class="mb-4">tetragon</h1>
            <p>
                a full-stack tournament logistics platform for real-time
                operations.
            </p>
            <div
                class="flex flex-wrap gap-x-4 gap-y-2 my-4 font-mono text-sm text-gray-500 lowercase"
            >
                <span class="rounded border border-[#333] px-2 py-0.5"
                    >next.js</span
                >
                <span class="rounded border border-[#333] px-2 py-0.5"
                    >typescript</span
                >
                <span class="rounded border border-[#333] px-2 py-0.5"
                    >react</span
                >
                <span class="rounded border border-[#333] px-2 py-0.5"
                    >supabase</span
                >
                <span class="rounded border border-[#333] px-2 py-0.5"
                    >tailwindcss</span
                >
            </div>
            <a
                href="https://github.com/smst/tetragon"
                target="_blank"
                class="text-sm"
            >
                github ↗
            </a>
        </header>

        <article>
            <hr />
            <h3>motivation</h3>
            <hr />
            <h3>architecture</h3>
            <hr />
            <h3>challenges</h3>
            <hr />
            <h3>outcome</h3>
            <hr />
            <div class="flex gap-4 text-sm">
                <a href="https://github.com/smst/tetragon" target="_blank">
                    github ↗
                </a>
                <a href="/">return home </a>
            </div>
        </article>
    </div>
</Layout>

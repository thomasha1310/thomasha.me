---
import "../styles/global.css";
const { title, description } = Astro.props;
---

<html
    lang="en"
    class="antialiased bg-[#0a0a0a] text-gray-300 selection:bg-white selection:text-black"
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title} • thomas ha</title>
        <meta name="description" content={description} />
    </head>
    <body class="max-w-2xl mx-auto px-6 py-20 flex flex-col min-h-screen">
        <main class="grow">
            <slot />
        </main>
    </body>
</html>

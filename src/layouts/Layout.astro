---
import '../styles/global.css';
const { title, description } = Astro.props;
---

<html lang="en" class="antialiased bg-[#0a0a0a] text-gray-300 selection:bg-white selection:text-black">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} • thomas ha</title>
    <meta name="description" content={description} />
  </head>
  <body class="max-w-2xl mx-auto px-6 py-20 flex flex-col min-h-screen">    
    <main class="grow">
      <slot />
    </main>

    <footer class="mt-20 text-sm text-gray-500 pb-8 flex justify-between">
      <div class="flex gap-4">
        <a href="mailto:hello@thomasha.me" class="hover:text-gray-300 transition-colors">email</a>
        <a href="https://github.com/YOUR_GITHUB" target="_blank" class="hover:text-gray-300 transition-colors">github</a>
        <a href="https://linkedin.com/in/YOUR_LINKEDIN" target="_blank" class="hover:text-gray-300 transition-colors">linkedin</a>
      </div>
    </footer>
  </body>
</html>